{
  "name": "pfs-chronicle-generator",
  "version": "1.0.0",
  "description": "A module to generate Pathfinder & Starfinder Society Chronicles.",
  "main": "scripts/main.js",
  "scripts": {
    "build": "npm run build:css && esbuild scripts/main.ts --bundle --outfile=dist/main.js --format=esm --sourcemap",
    "build:css": "sass scss/style.scss css/style.css --no-source-map --style=expanded",
    "watch": "npm run build:css && npx concurrently \"esbuild scripts/main.ts --bundle --outfile=dist/main.js --format=esm --sourcemap --watch\" \"sass scss/style.scss css/style.css --no-source-map --style=expanded --watch\"",
    "watch:css": "sass scss/style.scss css/style.css --no-source-map --style=expanded --watch",
    "test": "jest",
    "test:integration": "npx playwright test",
    "coverage:e2e": "node scripts/e2e-coverage.mjs",
    "foundry": "./scripts/foundry.sh",
    "integration": "./scripts/foundry.sh test run",
    "lint": "eslint scripts/**/*.ts tests/**/*.ts --max-warnings 5",
    "check:duplication": "node scripts-build/check-duplication.js",
    "check:quality": "npm run lint && npm run check:duplication",
    "test:all": "npm run test && npm run check:quality",
    "prepare": "husky",
    "validate:mermaid": "node scripts-build/validate-mermaid.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "concurrently": "^10.0.5",
    "convert-source-map": "^2.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "fvtt-types": "npm:@league-of-foundry-developers/foundry-vtt-types@^13.346.0-beta.20251209192131",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscpd": "^5.0.16",
    "lint-staged": "^17.6.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.9",
    "sass": "^1.102.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "v8-to-istanbul": "^9.3.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "js-yaml": "^5.2.2",
    "pdf-lib": "^1.17.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "fvtt-types": {
      "typescript": "$typescript"
    }
  }
}
